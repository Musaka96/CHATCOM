# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com
PRICE_CENTS=1990
APP_DOWNLOAD_URL=https://your-domain.com/downloads/CHAT-Setup.exe
OWNER_EMAIL=you@your-domain.com

# --- Database (Vercel Postgres / Neon / any Postgres connection string) ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Paddle ---
# Client-side token (Paddle Dashboard > Developer Tools > Authentication)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxx
# The Price ID for your $29.90 product (Paddle Dashboard > Catalog > Prices)
NEXT_PUBLIC_PADDLE_PRICE_ID=pri_xxx
# "sandbox" while testing, "production" once your domain is approved and you're live
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Webhook signing secret (Paddle Dashboard > Developer Tools > Notifications)
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx

# --- C.H.A.T. activation server (Scripts/vercel-api in the app repo) ---
# The deployed URL of your activation API, no trailing slash
CHAT_ACTIVATION_URL=https://chat-vercel-api.vercel.app
# Must match the ADMIN_KEY env var set on that Vercel project
CHAT_ACTIVATION_ADMIN_KEY=

# --- Resend ---
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=C.H.A.T. <noreply@your-domain.com>

# --- Admin panel ---
# Generate with: npm run hash-password
ADMIN_PASSWORD_HASH=
# Generate both secrets with: npm run gen-secret
KEY_ENCRYPTION_SECRET=
SESSION_SECRET=
